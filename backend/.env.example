# ===========================
# MongoDB Configuration
# ===========================
MONGODB_URI=mongodb://localhost:27017/farmer-help-portal
# For Docker: mongodb://root:password123@mongodb:27017/farmer-help-portal?authSource=admin

# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=development

# ===========================
# JWT Authentication
# ===========================
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars

# ===========================
# Cloudinary (Image Upload)
# ===========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================
# Email Configuration (Optional)
# ===========================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_SERVICE=gmail

# ===========================
# Third-party APIs
# ===========================
WEATHER_API_KEY=your_openweather_api_key
CROP_PRICE_API_KEY=your_crop_price_api_key
DISEASE_DETECTION_API_KEY=your_disease_api_key

# ===========================
# Development Settings
# ===========================
LOG_LEVEL=debug
REQUEST_TIMEOUT=30000
WEATHER_API_KEY=your_weather_api_key
COMMODITY_API_KEY=your_commodity_api_key
